package components

import (
  routes "github.com/gothicframework/core/router"
  "net/http"
)

type HelloWorldProps = interface {}

var HelloWorldConfig = routes.RouteConfig[HelloWorldProps]{
	Type: routes.STATIC,
	HttpMethod: routes.GET,
	Middleware: func(w http.ResponseWriter, r *http.Request) HelloWorldProps {
		return nil
	},
}

templ HelloWorld(props HelloWorldProps) {
	<div class="w-full">
		<div class="gothic-card p-6 text-center">
			<div class="gothic-kicker-muted">FROM THE SERVER</div>
			<p class="mt-3 text-lg font-semibold text-white">Hello from a real templ component</p>
			<p class="mt-1 text-sm text-gray-400">Rendered by Go, shipped as HTML, swapped in by HTMX.</p>
		</div>
	</div>
}
