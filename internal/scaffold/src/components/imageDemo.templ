package components

import (
	gothicComponents "github.com/gothicframework/components"
	routes "github.com/gothicframework/core/router"
	"net/http"
)

type ImageDemoProps = interface{}

var ImageDemoConfig = routes.RouteConfig[ImageDemoProps]{
	Type:       routes.STATIC,
	HttpMethod: routes.GET,
	Middleware: func(w http.ResponseWriter, r *http.Request) ImageDemoProps {
		return nil
	},
}

templ ImageDemo(props ImageDemoProps) {
	<section class="w-full max-w-4xl pb-4">
		<div class="grid gap-4 sm:grid-cols-2">
			<div class="p-7 text-center rounded-2xl bg-[linear-gradient(160deg,#14102b,#0b0817)] border border-[#2c2350] shadow-[0_0_60px_rgba(124,58,237,0.10)]">
				<div class="font-mono text-[10px] tracking-[0.28em] text-pink-400 uppercase">GOTHIC OPTIMIZEDIMAGE</div>
				<div class="mt-4 mx-auto w-full max-w-96 aspect-[4/3] rounded-2xl overflow-hidden bg-black">
					@gothicComponents.OptimizedImage(gothicComponents.OptimizedImageProps{IsFirstLoad: true, ImgName: "imageKeyboard", ImgExtension: "webp", Alt: "Backlit keyboard in neon light, fading into focus"})
				</div>
				<div class="mt-5 font-mono text-[10px] tracking-[0.28em] text-[#a78bfa] uppercase">FADES IN, NO GLITCH</div>
			</div>
			<div class="p-7 text-center rounded-2xl border border-[#2c2350] bg-[#0b0817]">
				<div class="font-mono text-[10px] tracking-[0.28em] text-gray-500 uppercase">PLAIN IMG TAG</div>
				<div class="mt-4 mx-auto w-full max-w-96 aspect-[4/3] rounded-2xl overflow-hidden bg-black">
					<img src="/public/imageKeyboard/original.webp" alt="The same image as a plain tag" class="w-full h-full object-contain"/>
				</div>
				<div class="mt-5 font-mono text-[10px] tracking-[0.28em] text-gray-500 uppercase">POPS IN WITH A GLITCH</div>
			</div>
		</div>
	</section>
}
