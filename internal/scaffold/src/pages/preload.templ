package pages

import (
	"{{.GoModName}}/src/layouts"
	"net/http"
	routes "github.com/gothicframework/core/router"
)

type PreloadPageProps = interface{}

var PreloadConfig = routes.RouteConfig[PreloadPageProps]{
	Type:       routes.STATIC,
	HttpMethod: routes.GET,
	Middleware: func(w http.ResponseWriter, r *http.Request) PreloadPageProps {
		return nil
	},
}

templ Preload(props PreloadPageProps) {
	@layouts.PageLayout(true) {
		<section class="text-center pt-12 pb-8 max-w-xl">
			<div class="font-mono text-[10px] tracking-[0.32em] text-pink-400 uppercase">BONUS · PRELOAD</div>
			<h1 class="mt-2 text-3xl sm:text-4xl font-extrabold">The next page arrives before you click</h1>
			<p class="mt-3 text-gray-400 text-sm sm:text-base max-w-md mx-auto leading-relaxed">
				Links can preload their destination <strong class="text-pink-400">on hover</strong>: the page is <strong class="text-blue-300">already rendered the moment you click</strong>. Less waiting also reads as speed to search engines.
			</p>
		</section>

		<div class="mb-2">
			<a href="/" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-[#2c2350] text-purple-300 font-mono text-[12px] hover:border-[#4c2d8f] hover:text-[#e9d5ff] transition-colors">← BACK TO OVERVIEW</a>
		</div>

		<section class="w-full max-w-xl pb-4">
			<div class="p-7 sm:p-9 text-center rounded-2xl bg-[linear-gradient(160deg,#14102b,#0b0817)] border border-[#2c2350] shadow-[0_0_60px_rgba(124,58,237,0.10)]">
				<div class="font-mono text-[10px] tracking-[0.28em] text-gray-500 uppercase">SEE IT IN THE NETWORK TAB</div>
				<ol class="mt-5 text-left text-[13px] text-gray-300 leading-relaxed list-none space-y-3 max-w-xs mx-auto">
					<li><span class="font-mono text-pink-400 text-[11px]">01</span> · Open your browser's Network tab</li>
					<li><span class="font-mono text-pink-400 text-[11px]">02</span> · Hover the link below, without clicking</li>
					<li><span class="font-mono text-pink-400 text-[11px]">03</span> · Watch the request fire while you hover</li>
					<li><span class="font-mono text-pink-400 text-[11px]">04</span> · Click: the page swaps in, already loaded</li>
				</ol>
				<div class="mt-8">
					<a href="/counter" preload="mouseover" class="inline-flex items-center justify-center px-7 py-3 rounded-full font-bold text-sm text-white bg-[linear-gradient(90deg,#ec4899,#7c3aed)] shadow-[0_8px_30px_rgba(236,72,153,0.30)] hover:brightness-110 transition">HOVER ME, DO NOT CLICK YET</a>
				</div>
				<p class="mt-4 text-[12px] text-gray-500">The attribute doing it: <span class="font-mono text-[11px] text-purple-300">preload="mouseover"</span></p>
			</div>
		</section>

		<section class="w-full max-w-xl pb-14 flex flex-wrap gap-2 justify-center items-center">
			<span class="font-mono text-[10px] tracking-[0.28em] text-gray-500 uppercase">DOCS:</span>
			<a href="https://gothicframework.com/docs/link" target="_blank" class="inline-flex items-center font-mono text-[10px] tracking-[0.14em] text-blue-300 border border-[#2c2350] rounded-full px-3 py-1.5 hover:border-[#4c2d8f] hover:text-purple-300 transition-colors">LINK PRELOAD</a>
		</section>
	}
}
