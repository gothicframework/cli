package pages

import (
	components "{{.GoModName}}/src/components"
	"{{.GoModName}}/src/layouts"
	. "github.com/gothicframework/core/wasm"
	"net/http"
	routes "github.com/gothicframework/core/router"
)

type McpPageProps = interface{}

var McpConfig = routes.RouteConfig[McpPageProps]{
	Type:       routes.STATIC,
	HttpMethod: routes.GET,
	Middleware: func(w http.ResponseWriter, r *http.Request) McpPageProps {
		return nil
	},
	WasmCompression: routes.BROTLI,
	ClientSideState: func() {
		CreateWasmFunc("copyMcpSnippet", func() {
			snippet := GetElementById("mcp-snippet").Get("textContent").String()
			WriteClipboard(snippet)
			SetText("mcp-copy-label", "COPIED ✓")
		})
	},
}


templ Mcp(props McpPageProps) {
	@layouts.PageLayout(true) {
		<section class="text-center pt-12 pb-8 max-w-xl">
			<div class="font-mono text-[10px] tracking-[0.32em] text-pink-400 uppercase">FEATURE 05 · AGENT FRIENDLY</div>
			<h1 class="mt-2 text-3xl sm:text-4xl font-extrabold">Your agent sees everything</h1>
			<p class="mt-3 text-gray-400 text-sm sm:text-base max-w-md mx-auto leading-relaxed">
				While your dev session runs, Gothic <strong class="text-blue-300">natively</strong> hosts its own Developer MCP server: your AI agent gets a <strong class="text-pink-400">360 view of the build</strong>, it sees, builds and observes. One process, <strong class="text-white">zero setup</strong>.
			</p>
		</section>

		<div class="mb-2">
			<a href="/" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-[#2c2350] text-purple-300 font-mono text-[12px] hover:border-[#4c2d8f] hover:text-[#e9d5ff] transition-colors">← BACK TO OVERVIEW</a>
		</div>

		<section class="w-full max-w-2xl pb-4">
			<div class="p-7 sm:p-9 rounded-2xl bg-[linear-gradient(160deg,#14102b,#0b0817)] border border-[#2c2350] shadow-[0_0_60px_rgba(124,58,237,0.10)]">
				<div class="flex items-start gap-4 text-left">
					<div class="font-mono text-[13px] text-pink-400">01</div>
					<div>
						<div class="font-mono text-[11px] tracking-[0.18em] text-[#e5e1ff] uppercase">KEEP THE SESSION RUNNING</div>
						<p class="mt-1 text-[12px] text-gray-400 leading-relaxed">The MCP server lives inside <span class="font-mono text-[11px] text-purple-300">gothic hot-reload</span>. While the dev session runs, the URL below is live.</p>
					</div>
				</div>
				<div class="mt-5 flex items-start gap-4 text-left">
					<div class="font-mono text-[13px] text-pink-400">02</div>
					<div class="w-full min-w-0">
						<div class="font-mono text-[11px] tracking-[0.18em] text-[#e5e1ff] uppercase">ADD IT TO YOUR CLIENT</div>
						<p class="mt-1 text-[12px] text-gray-400 leading-relaxed">One entry, one URL. Pick your client and paste the block.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="w-full max-w-2xl pb-4">
			@components.McpSetup("claude")
		</section>

		<section class="w-full max-w-2xl pb-4">
			<div class="p-7 rounded-2xl border border-[#2c2350] bg-[#0b0817]">
				<div class="flex items-start gap-4 text-left">
					<div class="font-mono text-[13px] text-pink-400">03</div>
					<div>
						<div class="font-mono text-[11px] tracking-[0.18em] text-[#e5e1ff] uppercase">LET YOUR AGENT DRIVE</div>
						<p class="mt-1 text-[12px] text-gray-400 leading-relaxed">Try it: <span class="font-mono text-[11px] text-purple-300">open the counter, click + five times and tell me the value</span>. Your agent does it through the same browser you do.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="w-full max-w-2xl pb-4">
			<div class="font-mono text-[10px] tracking-[0.32em] text-gray-500 uppercase">What your agent sees</div>
			<div class="mt-4 grid gap-3 sm:grid-cols-2">
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">navigate</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Open any page of the app.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">act</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Click, type, hover and scroll.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">view</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">See the page as it renders.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">probe</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Read the live DOM state.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">trace</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Follow every request and response.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">logs</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Read the browser event bus.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">build</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Run every build stage, errors translated.</div>
				</div>
				<div class="p-4 text-left rounded-xl border border-[#2c2350] bg-[#0b0817]">
					<div class="font-mono text-[11px] text-blue-300">skill</div>
					<div class="mt-1 text-[11px] text-gray-500 leading-relaxed">Load version matched framework skills.</div>
				</div>
			</div>
		</section>

		<section class="w-full max-w-2xl pb-14 flex flex-wrap gap-2 justify-center items-center">
			<span class="font-mono text-[10px] tracking-[0.28em] text-gray-500 uppercase">DOCS ↗</span>
			<a href="https://gothicframework.com" target="_blank" class="inline-flex items-center font-mono text-[10px] tracking-[0.14em] text-blue-300 border border-[#2c2350] rounded-full px-3 py-1.5 hover:border-[#4c2d8f] hover:text-purple-300 transition-colors">GOTHICFRAMEWORK.COM</a>
		</section>
	}
}
