{
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 6.0"
      }
    },
    "backend": {
      "gcs": {
        "bucket": "${var.state_bucket}",
        "prefix": "gothic/${var.project_name}/${var.stage}"
      }
    }
  },
  "provider": {
    "google": {
      "project": "${var.project}",
      "region": "${var.region}"
    }
  }
}
